{
  "name": "electron-ant",
  "version": "0.2.0",
  "description": "Electron + React Desktop Application",
  "private": true,
  "main": "electron/main.js",
  "author": "Langery",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm run react-dev\" \"npm run electron-dev\"",
    "react-dev": "vite",
    "electron-dev": "wait-on http://localhost:5175 && electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.15.0",
    "axios": "^1.17.0",
    "chart.xkcd": "^1.1.15",
    "chart.xkcd-react": "^0.0.6",
    "ionicons": "^5.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-rough": "^2.3.0",
    "react-router-dom": "^6.22.0",
    "rough-charts": "^0.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "less": "^4.2.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.electron.ant",
    "productName": "Electron-Ant",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Langery/Electron_text.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Langery/Electron_text/issues"
  },
  "homepage": "https://github.com/Langery/Electron_text#readme"
}
